    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Per-layer cache efficiency computed from rate() of hit and miss counter deltas: dnsdist packet cache, recursor packet cache, recursor record cache. Rates (not raw counters) keep the ratio meaningful across restarts and scrapes.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": ["mean", "lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(dnsdist_cache_hits[$__rate_interval])) / (sum(rate(dnsdist_cache_hits[$__rate_interval])) + sum(rate(dnsdist_cache_misses[$__rate_interval])))",
          "legendFormat": "dnsdist - packet cache",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(pdns_recursor_packetcache_hits[$__rate_interval])) / (sum(rate(pdns_recursor_packetcache_hits[$__rate_interval])) + sum(rate(pdns_recursor_packetcache_misses[$__rate_interval])))",
          "legendFormat": "recursor - packet cache",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(pdns_recursor_cache_hits[$__rate_interval])) / (sum(rate(pdns_recursor_cache_hits[$__rate_interval])) + sum(rate(pdns_recursor_cache_misses[$__rate_interval])))",
          "legendFormat": "recursor - record cache",
          "refId": "C"
        }
      ],
      "title": "Cache Hit Ratio by Layer",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "dnsdist edge latency from the dnstap-processor response-time histogram (dnstap CLIENT_RESPONSE response_time - query_time), prober=\"false\" series only: production truth, synthetic prober traffic excluded. Sub-millisecond buckets (0.1/0.25/0.5/1/2.5/5/10 ms) resolve latencies integer-millisecond counters round away.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
