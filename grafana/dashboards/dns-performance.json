        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": ["mean", "lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(dnstap_processor_response_latency_seconds_bucket{prober=\"false\"}[$__rate_interval]))) * 1000",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.90, sum by (le) (rate(dnstap_processor_response_latency_seconds_bucket{prober=\"false\"}[$__rate_interval]))) * 1000",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(dnstap_processor_response_latency_seconds_bucket{prober=\"false\"}[$__rate_interval]))) * 1000",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "Edge Response Latency p50/p90/p99 (production)",
      "type": "timeseries"
    },
